{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": { "api/index.ts": { "maxDuration": 15 } },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api?__path=:path*" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "redirects": [
    { "source": "/blog", "destination": "/media/news", "permanent": true },
    { "source": "/blog/:slug", "destination": "/media/news/:slug", "permanent": true },
    { "source": "/gallery", "destination": "/media/gallery", "permanent": true },
    { "source": "/en/blog", "destination": "/en/media/news", "permanent": true },
    { "source": "/en/blog/:slug", "destination": "/en/media/news/:slug", "permanent": true },
    { "source": "/en/gallery", "destination": "/en/media/gallery", "permanent": true }
  ]
}
