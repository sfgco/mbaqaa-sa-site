{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "description": "جمعية مبرة بقاء — website API (mbaqaa.sa)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "NODE_ENV=development tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "seed": "tsx src/scripts/seed.ts",
    "admin:create": "tsx src/scripts/create-admin.ts",
    "offline": "serverless offline"
  },
  "dependencies": {
    "@mbaqaa/shared": "*",
    "bcryptjs": "^3.0.2",
    "compression": "^1.8.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.0.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.18.0",
    "serverless-http": "^3.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.3",
    "mongodb-memory-server": "^10.2.0",
    "serverless-offline": "^14.4.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.0",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
