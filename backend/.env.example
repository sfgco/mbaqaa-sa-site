PORT=4000
MONGODB_URI=mongodb://localhost:27017/mbaqaa
# Signs dashboard sessions — REQUIRED in production (`openssl rand -base64 48`). Changing it signs everyone out.
JWT_SECRET=
JWT_EXPIRES_IN=12h
# First dashboard admin: created on the first login attempt while no admin exists,
# or run `npm run admin:create -w backend -- --email … --password … --name …`.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Comma-separated allowed origins, e.g. https://mbaqaa.sa,https://www.mbaqaa.sa (empty = same origin / any in dev)
CORS_ORIGINS=
# "lax" when the site and API share a domain (CloudFront /api/* → API). "none" when they are on different domains.
COOKIE_SAMESITE=lax
