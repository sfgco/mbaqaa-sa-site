PORT=3000
MONGODB_URI=mongodb://localhost:27017/mada
# Signs dashboard login sessions — REQUIRED in production (use a long random string,
# e.g. `openssl rand -base64 48`). Changing it signs everyone out.
JWT_SECRET=
# Session lifetime ("12h", "7d"…)
JWT_EXPIRES_IN=12h
# First dashboard admin: created on the first login attempt while no admin exists.
# Or run `pnpm admin:create --email … --password … --name …`.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Comma-separated allowed origins, e.g. https://madaaqaria.sa,https://www.madaaqaria.sa (empty = any)
CORS_ORIGINS=
CONTENT_CACHE_TTL_SECONDS=60
