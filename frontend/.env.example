# API base URL. Leave empty to use "/api" (Vite proxies it to the backend in dev; CloudFront routes it in production).
VITE_API_URL=
# Shared upload service (same as the taqoud.com projects): POST {VITE_API_UPLOAD}?path=<folder>, multipart "file"
# → { files: [{ url }] }. Used by the dashboard for governance PDFs and album photos. Empty = paste file URLs instead.
VITE_API_UPLOAD=
