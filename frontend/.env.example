# API base URL. Leave empty to use "/api" (Vite proxies it to the backend in dev; CloudFront routes it in production).
VITE_API_URL=
# Shared upload service: POST {VITE_API_UPLOAD}?project=mbaqaa, header x-api-key, multipart "file"
# → { project, uploaded: [{ url, key, size, contentType }], failed: [] }. Used by the dashboard for PDFs,
# album/post covers and QR images. Empty = uploads disabled.
VITE_API_UPLOAD=
# Sent as the x-api-key header. Public: it ends up in the browser bundle.
VITE_API_UPLOAD_KEY=
